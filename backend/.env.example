NODE_ENV=development
PORT=5000

FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=unique_mechanical_works
DB_USER=root
DB_PASSWORD=your_database_password

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ACCESS_TOKEN_COOKIE_NAME=umw_access_token
REFRESH_TOKEN_COOKIE_NAME=umw_refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax